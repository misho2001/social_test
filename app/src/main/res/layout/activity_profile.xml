<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent" android:padding="24dp">
    <TextView android:text="პროფილი" android:textSize="24sp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etName" android:hint="სახელი"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
    <EditText android:id="@+id/etBio" android:hint="ბიო" android:inputType="textMultiLine"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnSave" android:text="შენახვა"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
    <Button android:id="@+id/btnLogout" android:text="გამოსვლა"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
